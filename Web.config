<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <!-- Cadena de conexión como en la clase 3, pero apuntando a SQL Server LocalDB con autenticación de Windows.
         Si en otra PC usás SQL Server Express, cambiá el Data Source por .\SQLEXPRESS -->
    <add name="asesoria"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=asesoria;Integrated Security=True;"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true"/>
    <!-- 8192 KB para poder subir archivos de hasta 5 MB -->
    <httpRuntime maxRequestLength="8192"/>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
  </system.web>
</configuration>
